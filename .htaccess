# 0. Limites PHP pour l'upload de fichiers DICOM (prioritaire sur php.ini)
<IfModule php_module>
    php_value upload_max_filesize 200M
    php_value post_max_size 210M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 512M
    # Écrire les erreurs dans un fichier log plutôt que dans la réponse HTTP
    php_flag  display_errors Off
    php_flag  log_errors On
    php_value error_log "/var/log/apache2/php_error_dme.log"
</IfModule>

# 1. Empêcher l'affichage des dossiers (Sécurité)
Options -Indexes
Options -MultiViews

# 2. Activer le moteur de réécriture
RewriteEngine On

# 3. Base du projet (sous-dossier XAMPP)
RewriteBase /dme_hospital/

# 4. Support des fichiers DICOM
AddType application/dicom .dcm
AddType application/dicom .dicom

# 5. Forcer le type MIME pour les images de preview
AddType image/jpeg .jpg .jpeg

# 6. Si le fichier ou dossier existe physiquement, on ne fait rien
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# 7. Sinon, tout vers index.php
RewriteRule ^(.*)$ index.php [QSA,L]

# 8. Protection des fichiers sensibles
<FilesMatch "\.(sql|log|ini|sh|bak|env)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 9. CORS pour les polices (résout les erreurs mixed-content/CORS sur woff/woff2/ttf)
<IfModule mod_headers.c>
    <FilesMatch "\.(woff|woff2|ttf|otf|eot|svg)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>